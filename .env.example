# Canonical origin for metadata, sitemap and OG URLs (falls back to the Vercel production domain).
NEXT_PUBLIC_SITE_URL=https://blkthrone.com

# Sealed-leak denylist for builds that don't have sealed.local.json (e.g. Vercel).
# Comma- or newline-separated titles/slugs of anything not yet announced. Never commit real values.
SEALED_TERMS=

# ── Merch (Fourthwall Storefront API) ─────────────────────────────────────────────
# Locally, put these in .env.local at the repo root (next.config.ts loads it) or in apps/web/.env.local.
# If /merch says "opening soon", the server log names the missing or invalid variable.
# Storefront token from Fourthwall → Settings → For Developers (starts with "ptkn_").
# SECRET: server-only. It is never rendered, logged or sent to the browser.
# Set for production AND preview on Vercel. Without it /merch shows "opening soon".
# Never use Fourthwall Open API (Basic Auth) credentials here.
FOURTHWALL_STOREFRONT_TOKEN=
# Collection /merch lists (Fourthwall collection slug). Other collections become categories.
FOURTHWALL_COLLECTION_SLUG=all
# Your Fourthwall SHOP domain (e.g. yourshop.fourthwall.com, or the custom domain connected to
# the shop), bare hostname only: no https://, no path. Public. Checkout links go to
# https://<this>/cart/checkout, which Fourthwall documents on the shop domain. To confirm it:
# GET https://storefront-api.fourthwall.com/v1/shop?storefront_token=… → `domain`/`publicDomain`.
NEXT_PUBLIC_FOURTHWALL_SHOP_DOMAIN=
